# Copy to `grafana.env` (same directory) and set a REAL local password. NEVER commit `grafana.env`.
#   cp grafana.env.example grafana.env
# `grafana.env` is gitignored (matches the root `.gitignore` rule `*.env`); only THIS
# `.example` file is committed.
#
# These two keys feed the stable-named `grafana-admin` Secret (overlays/local
# secretGenerator, disableNameSuffixHash) that the rendered kube-prometheus-stack
# Grafana references via `admin.existingSecret`. A DEDICATED 2-key file on purpose:
# the generator ingests a whole env file, and feeding it secret.env used to mirror
# EVERY app secret (JWT_SECRET included) into a Secret readable with Grafana-side
# secret access. Grafana is reached by `kubectl port-forward` only (no Kong route,
# no NodePort).
#
# Generate a strong password locally, e.g.:  openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-grafana-password
