# Copy to `secret.env` (same directory) and fill REAL local values. NEVER commit `secret.env`.
#   cp secret.env.example secret.env
# `secret.env` is gitignored (matches the root `.gitignore` rule `*.env`); only THIS
# `.example` file is committed. Same key scheme as infra/.env, so you can also seed it
# straight from your Compose env:  grep -E '^(USER_DB_|PRODUCT_DB_|...)' infra/.env
#
# These feed the `ecommerce-secrets` Secret (overlays/local/kustomization.yaml).
# base64 in a K8s Secret is ENCODING, not encryption — that is exactly why no real
# value belongs in git. See infra/k8s/README.md.
#
# Generate strong values locally, e.g.:
#   openssl rand -base64 48   # JWT_SECRET / INTERNAL_API_KEY (>= 32 bytes or services fail fast)
#   openssl rand -hex 24      # DB / RabbitMQ passwords (URL-safe; notification builds a DSN from them)

# --- Per-service Postgres credentials (database-per-service) ---
USER_DB_USER=user_service
USER_DB_PASSWORD=change_me
PRODUCT_DB_USER=product_service
PRODUCT_DB_PASSWORD=change_me
ORDER_DB_USER=order_service
ORDER_DB_PASSWORD=change_me
CART_DB_USER=cart_service
CART_DB_PASSWORD=change_me
PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=change_me
NOTIFICATION_DB_USER=notification_service
NOTIFICATION_DB_PASSWORD=change_me

# --- Shared JWT secret (HS256) — User signs, the others validate ---
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes

# --- Shared internal service-to-service API key (Order -> Product) ---
INTERNAL_API_KEY=change-me-to-a-strong-random-internal-api-key

# --- First-admin bootstrap (User Service) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password

# --- RabbitMQ broker credentials ---
RABBITMQ_USER=ecommerce_mq
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# --- Payment Service secrets ---
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret
PAYMENT_GATEWAY_API_KEY=change-me-payment-gateway-api-key

# --- Notification Service email provider key ---
EMAIL_API_KEY=change-me-email-api-key

# --- Grafana admin (Wave 5c observability) ---
# Feeds the stable-named `grafana-admin` Secret (overlays/local secretGenerator,
# disableNameSuffixHash) that the rendered kube-prometheus-stack Grafana references
# by fixed name. Grafana is reached by `kubectl port-forward` only (no Kong route,
# no NodePort). NEVER commit a real password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-grafana-password
