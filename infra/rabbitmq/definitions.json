{
  "exchanges": [
    {
      "name": "ecommerce.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "spy.order-placed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 1000,
        "x-overflow": "drop-head",
        "x-message-ttl": 3600000
      }
    },
    {
      "name": "spy.payment-events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 1000,
        "x-overflow": "drop-head",
        "x-message-ttl": 3600000
      }
    }
  ],
  "bindings": [
    {
      "source": "ecommerce.events",
      "vhost": "/",
      "destination": "spy.order-placed",
      "destination_type": "queue",
      "routing_key": "order.placed",
      "arguments": {}
    },
    {
      "source": "ecommerce.events",
      "vhost": "/",
      "destination": "spy.payment-events",
      "destination_type": "queue",
      "routing_key": "payment.*",
      "arguments": {}
    }
  ]
}
