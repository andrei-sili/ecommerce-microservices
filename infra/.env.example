# Wave 0 — Postgres credentials per service (database-per-service).
# Copy to `infra/.env` and fill real values locally. NEVER commit `.env`.
# Pattern: <SERVICE>_DB_USER / <SERVICE>_DB_PASSWORD / <SERVICE>_DB_NAME.
# These are placeholders for local development only — replace before any shared/prod use.

# --- User Service DB (host port 5432) ---
USER_DB_USER=user_service
USER_DB_PASSWORD=change_me
USER_DB_NAME=user_db

# --- Product Service DB (host port 5433) ---
PRODUCT_DB_USER=product_service
PRODUCT_DB_PASSWORD=change_me
PRODUCT_DB_NAME=product_db

# --- Order Service DB (host port 5434) ---
ORDER_DB_USER=order_service
ORDER_DB_PASSWORD=change_me
ORDER_DB_NAME=order_db

# --- Cart Service DB (host port 5435) ---
CART_DB_USER=cart_service
CART_DB_PASSWORD=change_me
CART_DB_NAME=cart_db

# --- Payment Service DB (host port 5436) ---
PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=change_me
PAYMENT_DB_NAME=payment_db

# --- Notification Service DB (host port 5437) ---
NOTIFICATION_DB_USER=notification_service
NOTIFICATION_DB_PASSWORD=change_me
NOTIFICATION_DB_NAME=notification_db

# --- Shared JWT secret (HS256) ---
# Same value for every service: User signs tokens, the others validate locally.
# MUST be at least 32 bytes or both services fail fast on startup. Generate, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes

# --- First-admin bootstrap (seeded once by User Service if no admin exists) ---
# Password is BCrypt-hashed at runtime; nothing is committed to git.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password
