# User Service environment (placeholders only — never commit real secrets).
# Internal app port: 8081 (see api_contracts.md infra map).

# --- Database (PostgreSQL, owns user_db) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://user-db:5432/user_db
SPRING_DATASOURCE_USERNAME=user_svc
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT is RS256-only (Slice 5e phase 3). The legacy HS256 shared secret was removed
# (fail-closed, D3); emergency re-widening = git revert + a NEW secret, never a live env value. ---

# --- JWT RS256 key material (Slice 5e). Distributed as mounted FILES — paths only, never PEM here.
# Keys are generated + mounted by infra (infra/keys/, gitignored). Recipe:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-rs256-private.pem
#   openssl pkey -in jwt-rs256-private.pem -pubout -out jwt-rs256-public.pem
# User-service is the signer, so it mounts BOTH keys; consumers mount only the public key.
JWT_PRIVATE_KEY_PATH=/etc/jwt/jwt-rs256-private.pem
JWT_PUBLIC_KEY_PATH=/etc/jwt/jwt-rs256-public.pem

# --- JWT algorithm flags (phase-3 defaults: RS256-only). Independently rollbackable via env. ---
# JWT_ACCEPTED_ALGS: validator allowlist. JWT_SIGNING_ALG: issuer alg. Both default to RS256; HS256
# stays code-reachable for an emergency rollback, but the legacy secret is gone (see runbook).
# JWT_ACCEPTED_ALGS=RS256
# JWT_SIGNING_ALG=RS256

# --- First-admin bootstrap (seeded once at startup if no admin exists) ---
# Leave blank to skip seeding. The password is BCrypt-hashed at runtime.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password

# --- Optional overrides (defaults shown) ---
# SERVER_PORT=8081
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800
# DB_POOL_MAX_SIZE=10
