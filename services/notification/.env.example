# Database (notification_db on its own Postgres container)
DATABASE_URL=postgresql+asyncpg://notification:notification@notification-db:5432/notification_db

# RabbitMQ — individual parts (same names consumed by all platform services)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Optional: set this to override the URL built from the parts above (useful for local dev)
RABBITMQ_URL=

# Email provider (sandbox mode when empty)
EMAIL_API_KEY=

# Consumer
MAX_RETRIES=5
SKIP_CONSUMER=false
