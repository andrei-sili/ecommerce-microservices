# Order Service — required environment variables (placeholders only, no real secrets)

# --- Database (PostgreSQL, owns order_db) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://order-db:5432/order_db
SPRING_DATASOURCE_USERNAME=order
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT validation (RS256-only, Slice 5e phase 3) ---
# Order validates tokens issued by the User Service; it never issues tokens. The legacy HS256
# shared secret was removed (fail-closed, D3) — emergency re-widening = git revert + a NEW secret.
# JWT_PUBLIC_KEY_PATH: mounted RS256 public-key file (path only, never PEM content).
JWT_PUBLIC_KEY_PATH=/etc/jwt/jwt-rs256-public.pem
# JWT_ACCEPTED_ALGS: validator allowlist (defaults to RS256; HS256 stays code-reachable for rollback).
# JWT_ACCEPTED_ALGS=RS256

# --- Service-to-service auth ---
# Shared key for SYSTEM calls to Product's internal inventory reservation API.
# Sent as the X-Internal-Api-Key header. Must match the Product Service value exactly.
INTERNAL_API_KEY=change-me-shared-internal-api-key

# --- Downstream services (intra-Docker-network base URLs) ---
CART_SERVICE_URL=http://cart:8083
PRODUCT_SERVICE_URL=http://product:8082

# --- RabbitMQ (Wave 3 — outbox relay + payment event consumer) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=change-me-rabbitmq-user
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_VHOST=/

# --- App ---
SERVER_PORT=8084
