# Order Service — required environment variables (placeholders only, no real secrets)

# --- Database (PostgreSQL, owns order_db) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://order-db:5432/order_db
SPRING_DATASOURCE_USERNAME=order
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT (HS256) ---
# Shared secret used ONLY to VALIDATE tokens issued by the User Service.
# Order does NOT issue tokens. Must match the User Service value exactly.
JWT_SECRET=change-me-shared-hs256-secret-at-least-32-bytes

# --- Service-to-service auth ---
# Shared key for SYSTEM calls to Product's internal inventory reservation API.
# Sent as the X-Internal-Api-Key header. Must match the Product Service value exactly.
INTERNAL_API_KEY=change-me-shared-internal-api-key

# --- Downstream services (intra-Docker-network base URLs) ---
CART_SERVICE_URL=http://cart:8083
PRODUCT_SERVICE_URL=http://product:8082

# --- App ---
SERVER_PORT=8084
