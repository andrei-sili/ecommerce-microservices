<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.ecommerce</groupId>
  <artifactId>payment</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>payment-service</name>
  <description>Payment Service — gateway charging, idempotency, outbox relay, webhook verification</description>

  <properties>
    <java.version>21</java.version>
    <!-- Pinned at 42.7.12, which carries the fix for CVE-2026-54291 (HIGH — a SCRAM-SHA-256-PLUS
         downgrade lets an attacker bypass channel-binding MITM protection). This is now one patch
         BELOW the 42.7.13 the Boot 4.1.1 BOM manages, and is held deliberately: pgjdbc is the
         mechanism behind the pod-loss readiness invariant (socketTimeout bounding a read on a dead
         socket), so moving the driver inside a version bump would destroy the attribution the
         two-commit split exists to preserve. Dropping the override so the fleet inherits 42.7.13 is
         owned by the fleet-verification slice — the override is identical in all five poms, so one
         service removing it alone would split the fleet on a shared transitive pin. -->
    <postgresql.version>42.7.12</postgresql.version>
    <!-- The Boot 4.1.1 BOM manages tomcat 11.0.24: CVE-2026-65182, CVE-2026-65905 and
         CVE-2026-68525 are all CRITICAL and all carry a fix, so none is waivable under the gate
         policy. Pinned at 11.0.25 on 2026-09-06.
         Removal condition: delete this override once the parent BOM manages >= 11.0.25 (the first
         Boot 4.1.x/4.2.x that does), and re-scan to prove it. -->
    <tomcat.version>11.0.25</tomcat.version>
    <jjwt.version>0.12.6</jjwt.version>
    <!-- Override the Boot 3.5.16 BOM (5.25.0) and the Boot 4.1.x BOM (5.30.0): CVE-2026-63337,
         CVE-2026-69219, CVE-2026-69220 — all HIGH, all with a fix available, so none is waivable
         under the gate policy. Advisories give `< 5.33.0` and `<= 5.33.0`, so both BOM versions are
         affected: this is pre-existing exposure, not a migration regression. The property carries
         the same name in both BOMs, so the pin survives the Boot 4 bump.
         Owner S6: delete once the destination BOM manages >= 5.33.1, and re-scan to prove it. -->
    <rabbit-amqp-client.version>5.33.1</rabbit-amqp-client.version>
    <spotless.version>2.43.0</spotless.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Required to COMPILE, not a precaution. This starter is the only thing on the tree that
         provides org.springframework.boot.restclient and org.springframework.boot.http.client,
         and ClientsConfig imports both (RestClientCustomizer, HttpClientSettings) — Boot 4 moved
         them out of the modules starter-web pulls in. Removing it does not degrade behaviour, it
         fails the build:
           ClientsConfig.java:[5,44] package org.springframework.boot.http.client does not exist
           ClientsConfig.java:[7,43] package org.springframework.boot.restclient does not exist
         Compile scope because ClientsConfig is src/main. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Prometheus scrape format for /actuator/prometheus (version managed by Boot BOM). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>

    <!-- Boot 4 split the monolithic autoconfigure jar into per-technology modules, so
         FlywayAutoConfiguration now ships in spring-boot-flyway (pulled by this starter) rather
         than alongside flyway-core. Declaring only the library leaves Flyway silently NOT running:
         no migration, no error. It surfaces here solely because ddl-auto: validate is armed. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- JWT validation (no issuance in Payment) -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- commons-codec for hex encoding (HMAC-SHA256 webhook verification) -->
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 split the test slices into per-technology modules: @AutoConfigureMockMvc and
         @WebMvcTest moved to org.springframework.boot.webmvc.test.autoconfigure. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Replaces spring-security-test. Boot 4 did not DROP the MockMvc slice's security
         auto-configuration, it MOVED it: spring-boot-security-test contributes its own
         AutoConfigureMockMvc.imports carrying SecurityAutoConfiguration,
         UserDetailsServiceAutoConfiguration, SecurityFilterAutoConfiguration,
         ServletWebSecurityAutoConfiguration and SecurityMockMvcAutoConfiguration. Dropping the old
         artifact because no @WithMockUser/springSecurity() call exists misses this entirely: a
         slice's security posture arrives through .imports, not through the test API, so counting
         API usages cannot see it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @AutoConfigureObservability is gone; @AutoConfigureMetrics lives here and is what keeps
         MetricsEndpointIntegrationTest running against an exporting registry. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-metrics-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real HTTP stand-in for the Order seam (OrderClient over a socket, never mocked) -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>3.9.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>2.0.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
