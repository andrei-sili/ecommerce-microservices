# Payment Service — required environment variables (placeholders only, no real secrets)

# --- Database (PostgreSQL, owns payment_db) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://payment-db:5432/payment_db
SPRING_DATASOURCE_USERNAME=payment
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT is RS256-only (Slice 5e phase 3) ---
# Payment VALIDATES tokens issued by the User Service; it never issues them. The legacy HS256 shared
# secret was removed (fail-closed, D3) — emergency re-widening = git revert + a NEW secret, never a
# live env value.
# JWT_ACCEPTED_ALGS: validator allowlist. Defaults to RS256; HS256 stays code-reachable for an
# emergency rollback, but the legacy secret is gone (see runbook).
# JWT_ACCEPTED_ALGS=RS256

# --- Webhook signature verification ---
# HMAC-SHA256 key for verifying gateway webhook payloads.
# Must match the value configured in the payment gateway (Stripe webhook secret, etc.).
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# --- Payment gateway ---
# API key for the payment gateway (unused in sandbox mode — set for prod swap-in).
PAYMENT_GATEWAY_API_KEY=change-me-gateway-api-key

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# --- Downstream services ---
ORDER_SERVICE_URL=http://order-service:8084

# --- App ---
SERVER_PORT=8085
