<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.ecommerce</groupId>
  <artifactId>product</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>product-service</name>
  <description>Product Service — catalog and inventory</description>

  <properties>
    <java.version>21</java.version>
    <!-- Pinned at 42.7.12, which carries the fix for CVE-2026-54291 (HIGH — a SCRAM-SHA-256-PLUS
         downgrade lets an attacker bypass channel-binding MITM protection). This is now one patch
         BELOW the 42.7.13 the Boot 4.1.1 BOM manages, and is held deliberately: pgjdbc is the
         mechanism behind the pod-loss readiness invariant (socketTimeout bounding a read on a dead
         socket), so moving the driver inside a version bump would destroy the attribution the
         two-commit split exists to preserve. Dropping the override so the fleet inherits 42.7.13 is
         owned by the fleet-verification slice — the override is identical in all five poms, so one
         service removing it alone would split the fleet on a shared transitive pin. -->
    <postgresql.version>42.7.12</postgresql.version>
    <!-- The Boot 4.1.1 BOM manages tomcat 11.0.24: CVE-2026-65182, CVE-2026-65905 and
         CVE-2026-68525 are all CRITICAL and all carry a fix, so none is waivable under the gate
         policy. Pinned at 11.0.25 on 2026-09-06.
         Removal condition: delete this override once the parent BOM manages >= 11.0.25 (the first
         Boot 4.1.x/4.2.x that does), and re-scan to prove it. -->
    <tomcat.version>11.0.25</tomcat.version>
    <jjwt.version>0.12.6</jjwt.version>
    <spotless.version>2.43.0</spotless.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Prometheus scrape registry for /actuator/prometheus; version pinned by the Boot BOM. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Boot 4 split the monolithic autoconfigure jar into per-technology modules, so
         FlywayAutoConfiguration now ships in spring-boot-flyway (pulled by this starter) rather
         than alongside flyway-core. Declaring only the library leaves Flyway silently NOT running:
         no migration, no error. It surfaces here solely because ddl-auto: validate is armed. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- JWT validation only (no issuance in Product) -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 split the test slices into per-technology modules: @AutoConfigureMockMvc and
         @WebMvcTest moved to org.springframework.boot.webmvc.test.autoconfigure. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Replaces spring-security-test. Boot 4 did not DROP the MockMvc slice's security
         auto-configuration, it MOVED it: spring-boot-security-test contributes its own
         AutoConfigureMockMvc.imports carrying SecurityAutoConfiguration,
         UserDetailsServiceAutoConfiguration, SecurityFilterAutoConfiguration,
         ServletWebSecurityAutoConfiguration and SecurityMockMvcAutoConfiguration. Dropping the old
         artifact because no @WithMockUser/springSecurity() call exists misses this entirely: a
         slice's security posture arrives through .imports, not through the test API, so counting
         API usages cannot see it. Product is the fleet's largest exposure here — two @WebMvcTest
         classes importing SecurityConfig, whose filterChain takes HttpSecurity. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @AutoConfigureObservability is gone; @AutoConfigureMetrics lives here and is what keeps
         the Prometheus scrape assertions running against an exporting registry. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-metrics-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TEST scope only: product has no outbound REST client, unlike order. This is here because
         Boot 4 no longer registers a TestRestTemplate for @SpringBootTest(RANDOM_PORT); the type
         moved to spring-boot-resttestclient (pulled by starter-webmvc-test) and is armed by
         @AutoConfigureTestRestTemplate, whose TestRestTemplateTestAutoConfiguration needs
         org.springframework.boot.restclient.RestTemplateBuilder — which that starter does NOT
         bring. Without this line the metrics context dies with NoClassDefFoundError while every
         import resolves and the module compiles. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>2.0.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Run the Testcontainers integration tests (*IT) under `mvn test` alongside the unit tests,
        so the reservation/catalog suites are part of the standard gate. They do NOT self-skip:
        AbstractIntegrationTest starts the container in @BeforeAll and fails LOUDLY when Docker is
        unavailable or incompatible, precisely so a misconfigured Docker cannot masquerade as a
        green "Tests run: 0". Do not "restore" a self-skip here — there never was one, and adding
        one would turn a red gate silent.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
