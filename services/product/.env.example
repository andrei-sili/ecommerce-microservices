# Product Service — required environment variables (placeholders only, no real secrets)

# --- Database (PostgreSQL, owns product_db) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://product-db:5432/product_db
SPRING_DATASOURCE_USERNAME=product
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT (RS256-only validation, Slice 5e phase 3) ---
# Product only VALIDATES tokens issued by the User Service; it never signs.
# Validator allowlist (comma-separated). Phase 3 posture: RS256 only. The legacy JWT_SECRET is gone
# (fail-closed) — an emergency rollback to HS256 needs a git revert plus a NEW secret, not an env toggle.
JWT_ACCEPTED_ALGS=RS256
# Path to the mounted X.509/SPKI RSA public key (never PEM content in env). Provided by infra.
JWT_PUBLIC_KEY_PATH=/etc/jwt/keys/jwt-rs256-public.pem

# --- Internal service-to-service auth (Wave 2) ---
# Shared key for the internal inventory reservation endpoints (Order -> Product).
# Sent as the X-Internal-Api-Key header; must match the value injected into the Order service.
# NOT a user JWT and NOT the ADMIN role — this is a system call.
INTERNAL_API_KEY=change-me-shared-internal-api-key

# --- Reservation TTL and sweeper (Wave 3) ---
# How long a RESERVED stock hold is valid before the sweeper releases it (minutes).
RESERVATION_TTL_MINUTES=30
# Fixed delay between sweeper runs in milliseconds (default 60 000 = 1 minute).
RESERVATION_SWEEPER_DELAY_MS=60000

# --- App ---
SERVER_PORT=8082
