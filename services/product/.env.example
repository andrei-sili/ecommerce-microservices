# Product Service — required environment variables (placeholders only, no real secrets)

# --- Database (PostgreSQL, owns product_db) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://product-db:5432/product_db
SPRING_DATASOURCE_USERNAME=product
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT (HS256) ---
# Shared secret used ONLY to VALIDATE tokens issued by the User Service.
# Product does NOT issue tokens. Must match the User Service value exactly.
JWT_SECRET=change-me-shared-hs256-secret-at-least-32-bytes

# --- App ---
SERVER_PORT=8082
