# Cart Service — required environment variables (placeholders only, no real secrets)

# --- Database (PostgreSQL, owns cart_db) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://cart-db:5432/cart_db
SPRING_DATASOURCE_USERNAME=cart
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT (RS256-only, Slice 5e phase 3) ---
# Cart only VALIDATES tokens issued by the User Service; it never signs.
# The legacy HS256 shared secret was removed (fail-closed, D3): emergency re-widening = git revert
# plus a NEW secret, never a live env value.
# Validator allowlist (comma-separated). Phase 3 accepts RS256 only.
JWT_ACCEPTED_ALGS=RS256
# Path to the mounted X.509/SPKI RSA public key (never PEM content in env). Provided by infra.
JWT_PUBLIC_KEY_PATH=/etc/jwt/keys/jwt-rs256-public.pem

# --- Product Service (price/availability snapshot source) ---
# Base URL of the Product Service; public read endpoints are used for validation + snapshot.
PRODUCT_SERVICE_URL=http://product:8082
PRODUCT_SERVICE_CONNECT_TIMEOUT_MS=2000
PRODUCT_SERVICE_READ_TIMEOUT_MS=3000

# --- App ---
SERVER_PORT=8083
